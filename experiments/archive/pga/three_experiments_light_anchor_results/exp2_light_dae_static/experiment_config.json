    "n_heads": 4,
    "n_layers": 2,
    "top_k": null,
    "dropout": 0.2,
    "ff_mult": 4,
    "pos_weight_scale": 1.1,
    "seed": 42,
    "n_splits": 5,
    "num_workers": 0,
    "device": "cpu"
  },
  "experiment": {
    "name": "exp2_light_dae_static",
